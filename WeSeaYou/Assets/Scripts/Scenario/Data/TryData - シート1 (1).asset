  Entries:
  - ID: CH0T_MS_001
    Name: FKMARE
    JPText: "\u795D\uFF01\u3000\u3046\u307F\u3044\u3053\u4F53\u9A13\u7248\uFF01\u3000\u3044\u3048\u30FC\uFF01"
    ENText: 
    CNText: 
  - ID: CH0T_MS_002
    Name: FKMARE
    JPText: "\u672C\u4F5C\u306F\uFF01\u3000\u6587\u660E\u5D29\u58CA\u5F8C\u306E\u5730\u7403\u3092\u821E\u53F0\u306B\u3001\\n\u30DC\u30AF\u3053\u3068\u5B87\u5B99\u4EBA\u30B7\u30FC\u3068\uFF01"
    ENText: 
    CNText: 
  - ID: CH0T_MS_003
    Name: FKSEA
    JPText: "\u5730\u7403\u4EBA\u30DE\u30FC\u30EC\u304C"
    ENText: 
    CNText: 
  - ID: CH0T_MS_004
    Name: FKMARE
    JPText: "\u6D77\u3092\u76EE\u6307\u3057\u3066\u65C5\u3092\u3059\u308B/n\u30A2\u30AF\u30B7\u30E7\u30F3\u30D1\u30BA\u30EB\u30B2\u30FC\u30E0\u3067\u3059\uFF01\u3000\u3084\u3063\u305F\u30FC\uFF01"
    ENText: 
    CNText: 
  - ID: CH0T_MS_005
    Name: FKSEA
    JPText: "\u30C6\u30F3\u30B7\u30E7\u30F3\u9AD8\u3044\u306A"
    ENText: 
    CNText: 
  - ID: CH0T_MS_006
    Name: FKMARE
    JPText: "\u3060\u3063\u3066\u3001\u4F53\u9A13\u7248\u3060\u3088\u4F53\u9A13\u7248\uFF01\u3000\\n\u82E6\u7BC0\u516B\u5E74\u3001\u5C71\u3042\u308A\u8C37\u3042\u308A\u30A2\u30AF\u30B7\u30E7\u30F3\u3042\u308A\\n\u30D1\u30BA\u30EB\u3042\u308A\u611F\u52D5\u3042\u308A\u7206\u767A\u30AA\u30C1\u3042\u308A\u3001\\n\u6570\u3005\u306E\u82E6\u96E3\u3092\u4E57\u308A\u8D8A\u3048\u3066\\n\u3088\u3046\u3084\u304F\u305F\u3069\u308A\u7740\u3044\u305F\u7D04\u675F\u306E\u571F\u5730\u3060\u3088\uFF01"
    ENText: 
    CNText: 
  - ID: CH0T_MS_007
    Name: FKSEA
    JPText: "\u306A\u304B\u3063\u305F\u8A18\u61B6\u3092\u4F5C\u308B\u3093\u3058\u3083\u306A\u3044"
    ENText: 
    CNText: 
  - ID: CH0T_MS_009
    Name: FKSEA
    JPText: "\u3042\u3042\u3082\u3046\u3001\u3071\u305F\u3071\u305F\u3059\u308B\u304B\u3089\\n\u30CD\u30AF\u30BF\u30A4\u66F2\u304C\u3063\u3066\u308B\u305E"
    ENText: 
    CNText: 
  - ID: CH0T_MS_010
    Name: FKMARE
    JPText: "\u3042\u308A\u304C\u3068\u3046\u3001\u30DE\u30FC\u30EC\uFF01"
    ENText: 
    CNText: 
  - ID: CH0T_MS_011
    Name: FKSEA
    JPText: "\u30B7\u30FC\u3002\u540D\u672D\u9593\u9055\u3063\u3066\u305F"
    ENText: 
    CNText: 
  - ID: CH0T_MS_012
    Name: FKMARE
    JPText: "\u30B3\u30DB\u30F3"
    ENText: 
    CNText: 
  - ID: CH0T_MS_013
    Name: FKMARE
    JPText: "\u3044\u3084\u3001\u540D\u672D\u306F\u9593\u9055\u3063\u3066\u306A\u3044\u305E\uFF01"
    ENText: 
    CNText: 
  - ID: CH0T_MS_014
    Name: FKSEA
    JPText: "\u3048\uFF1F"
    ENText: 
    CNText: 
  - ID: CH0T_MS_016
    Name: FKSEA
    JPText: "\"\u304A\u3044\u3001\u3061\u3087\u3063\u3068\u5F85\u3066\u3001\u30B7\u30FC\uFF01\u3000\\n\u305D\u308C\u307C\u304F\u306E\u30DE\u30CD\u304B!?\""
    ENText: 
    CNText: 
  - ID: CH0T_MS_017
    Name: FKMARE
    JPText: "\u5192\u967A\u306E\u59CB\u307E\u308A\u3060\u30FC\uFF01"
    ENText: 
    CNText: 
  - ID: CH0T_MS_018
    Name: FKMARE
    JPText: "\"\u3080\u3075\u30FC\u3002\u30DC\u30AF\u3053\u3068\u5730\u7403\u4EBA\u30DE\u30FC\u30EC\u306E\u304A\u304B\u3052\u3067\\n\u3053\u306E\u96E3\u6240\u3082\u7A81\u7834\u3067\u304D\u305F\u306A\uFF01\""
    ENText: 
    CNText: 
  - ID: CH0T_MS_019
    Name: FKSEA
    JPText: "\u305D\u308C\u7D9A\u3051\u308B\u306E\u304B\uFF1F"
    ENText: 
    CNText: 
  - ID: CH0T_MS_020
    Name: FKMARE
    JPText: "\u3055\u3042\u3001\u6B21\u306E\u5192\u967A\u3060\uFF01\u3000\u3044\u3053\u3046\u3001\u30B7\u30FC\uFF01"
    ENText: 
    CNText: 
  - ID: CH0T_MS_021
    Name: FKSEA
    JPText: "\"\u306F\u3044\u306F\u3044\u3001\u30DE\u30FC\u30EC\u30DE\u30FC\u30EC\u3002\\n\u306A\u3093\u3060\u304B\u65B0\u9BAE\u3067\u306F\u3042\u308B\u3088\""
    ENText: 
    CNText: 
  - ID: CH0T_MS_023
    Name: FKSEA
    JPText: "\u4EE3\u308F\u308B\u304B\uFF1F"
    ENText: 
    CNText: 
  - ID: CH0T_MS_024
    Name: FKMARE
    JPText: "\u5F85\u3063\u3066\u3002\u3082\u3046\u3061\u3087\u3063\u3068\u9811\u5F35\u308A\u305F\u3044"
    ENText: 
    CNText: 
  - ID: CH0T_MS_025
    Name: FKSEA
    JPText: "\u305D\u3046\u304B"
    ENText: 
    CNText: 
  - ID: CH0T_MS_026
    Name: FKMARE
    JPText: "\u3046\u3093\u3002\u30DC\u30AF\u3001\u4ECA\u30DE\u30FC\u30EC\u3060\u304B\u3089"
    ENText: 
    CNText: 
  - ID: CH0T_MS_027
    Name: MARE
    JPText: "\u3053\u308C\u3067\u5B8C\u6210\u3060\u306A"
    ENText: 
    CNText: 
  - ID: CH0T_MS_028
    Name: SEA
    JPText: "\u308F\u3041\uFF01\u3000\u3059\u3054\u3044\u3088\u3001\u30DE\u30FC\u30EC\uFF01\u3000\\n\u3053\u3093\u306A\u306B\u3042\u3063\u3055\u308A\uFF01"
    ENText: 
    CNText: 
  - ID: CH0T_MS_029
    Name: MARE
    JPText: "\u3082\u3046\u3044\u3044\u306E\u304B\uFF1F"
    ENText: 
    CNText: 
  - ID: CH0T_MS_030
    Name: SEA
    JPText: "\u3046\u3093\u3002\u30DC\u30AF\u3058\u3083\u30DE\u30FC\u30EC\u306E\u4EE3\u308F\u308A\u306F\u3067\u304D\u306A\u304B\u3063\u305F\u304B\u3089\u2026\u2026"
    ENText: 
    CNText: 
  - ID: CH0T_MS_031
    Name: MARE
    JPText: "\"\u2026\u2026\u3042\u30FC\u3001\u306E\u3069\u4E7E\u3044\u305F\u306A\u30FC\u3002\u3067\u3082\u3001\u9AD8\u53F0\u3060\u304B\u3089\u53D6\u308C\u306A\u3044\u306A\u2015\u3002\u56F0\u3063\u305F\u306A\u2015\u3002\u8AB0\u304B\u5B87\u5B99\u4EBA\u30D1\u30EF\u30FC\u3067\u52A9\u3051\u3066\u304F\u308C\u308B\u4EBA\u306F\u3044\u306A\u3044\u304B\u306A\u30FC\""
    ENText: 
    CNText: 
