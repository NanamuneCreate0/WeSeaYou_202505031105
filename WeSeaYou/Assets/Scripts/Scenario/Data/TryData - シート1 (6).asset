    JPText: "\u304A\u3044\u3001\u3061\u3087\u3063\u3068\u5F85\u3066\u3001\u30B7\u30FC\uFF01\u3000\\n\u305D\u308C\u307C\u304F\u306E\u30DE\u30CD\u304B!?"
