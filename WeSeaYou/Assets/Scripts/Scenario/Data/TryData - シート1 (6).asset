    JPText: "\u3055\u3042\u3001\u3044\u304F\u305E\u3001\u30B7\u30FC\uFF01\u3000\\n\u30DC\u30AF\u3053\u3068\u5730\u7403\u4EBA\u30DE\u30FC\u30EC\u306B\u4ED8\u3044\u3066\u304F\u308B\u3093\u3060\uFF01"
